<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Core SplashScreen does not animate icons before API 31. Show the complete mark. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_screen_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">550</item>
        <item name="postSplashScreenTheme">@style/Theme.IrRemote</item>
    </style>
</resources>
