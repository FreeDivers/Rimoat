# Normalize source files while keeping the Windows launcher native.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
gradlew text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Runtime databases and native encoder binaries.
*.db filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.jar binary
*.png binary
