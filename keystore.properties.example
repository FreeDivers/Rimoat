# Copy these fields into the ignored keystore.properties and replace placeholders.
# UTF-8; relative storeFile paths resolve from the project root.
# On Windows use forward slashes, e.g. C:/private-keys/rimoat-release.jks.
# Java properties escaping applies (use \\ for a literal backslash).
storeFile=/path/to/private/rimoat-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
